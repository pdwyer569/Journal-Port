rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isValidUserProfile(data, userId) {
      return data.size() == 2
        && data.keys().hasAll(['email', 'createdAt'])
        && data.email is string && data.email.size() <= 256
        && data.createdAt is timestamp;
    }

    function isValidJournalEntry(data, userId) {
      return data.size() == 7
        && data.keys().hasAll(['userId', 'text', 'moodId', 'attachments', 'tags', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.text is string && data.text.size() <= 100000
        && data.moodId is string && data.moodId.size() <= 10
        && data.attachments is list && data.attachments.size() <= 10
        && (data.attachments.size() == 0 || data.attachments[0] is string)
        && data.tags is list && data.tags.size() <= 20
        && (data.tags.size() == 0 || data.tags[0] is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId)
                    && isValidUserProfile(incoming(), userId)
                    && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId)
                    && isValidUserProfile(incoming(), userId)
                    && incoming().createdAt == existing().createdAt
                    && incoming().diff(existing()).affectedKeys().hasOnly(['email']);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /entries/{entryId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
        allow list: if isOwner(userId) && isValidId(userId);
        
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(entryId)
                      && isValidJournalEntry(incoming(), userId)
                      && incoming().createdAt == request.time
                      && incoming().updatedAt == request.time;
                      
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(entryId)
                      && isValidJournalEntry(incoming(), userId)
                      && incoming().createdAt == existing().createdAt
                      && incoming().userId == existing().userId
                      && incoming().updatedAt == request.time
                      && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'moodId', 'attachments', 'tags', 'updatedAt']);
                      
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
      }
    }
  }
}
