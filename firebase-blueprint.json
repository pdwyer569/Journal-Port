{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "createdAt"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "A single chronological journal entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "moodId": { "type": "string" },
        "attachments": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "text", "moodId", "attachments", "tags", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "The root document for a user."
    },
    "/users/{userId}/entries/{entryId}": {
      "schema": { "$ref": "#/entities/JournalEntry" },
      "description": "The journal entries belonging to a user."
    }
  }
}
